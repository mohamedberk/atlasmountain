{
  "name": "green-atlas-travel",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed.ts",
    "seed:activities": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed-activities.ts",
    "export-data": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local src/export-data.ts",
    "import-data": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local src/import-data.ts",
    "import-globals": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local src/import-globals.ts",
    "import-media": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local src/import-media.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@marsidev/react-turnstile": "^1.5.2",
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-resend": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-uploadthing": "3.84.1",
    "@payloadcms/translations": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@types/leaflet": "^1.9.21",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-auto-scroll": "^8.0.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.12.0",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next": "15.5.9",
    "next-intl": "^4.6.1",
    "payload": "3.84.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-international-phone": "^4.8.0",
    "react-leaflet": "^5.0.0",
    "sharp": "0.34.2",
    "sonner": "^2.0.3",
    "stripe": "^20.1.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "pg": "^8.16.3",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.24",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
